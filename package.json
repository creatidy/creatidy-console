{
  "name": "creatidy-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "start": "node server/main.ts",
    "bootstrap": "node server/bootstrap.ts issue",
    "build": "node scripts/build.mjs",
    "build:native-owner": "node scripts/build-native-owner.mjs",
    "build:check": "node scripts/build.mjs --check",
    "format:check": "node scripts/lint.mjs format",
    "lint:markdown": "node scripts/lint.mjs markdown",
    "lint:links": "node scripts/check-links.mjs",
    "lint:secrets": "node scripts/lint.mjs secrets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint:markdown && npm run lint:links && npm run lint:secrets && npm run typecheck && npm test && npm run build:check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/session": "11.1.6",
    "@fastify/static": "10.1.10",
    "@humanwhocodes/momoa": "3.3.13",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.23.3",
    "playwright-core": "1.65.0",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.3"
  }
}
